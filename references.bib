	keywords = {Discrete games, Empirical modelling, Entry},
	pages = {985--992},
}


@article{toivanen2005MarketStructureEntry,
	title = {Market {Structure} and {Entry}: {Where}'s the {Beef}?},
	volume = {36},
	issn = {0741-6261},
	shorttitle = {Market {Structure} and {Entry}},
	url = {https://www.jstor.org/stable/4135236},
	abstract = {We study the effects of market structure on entry using data from the U.K. fast food (counter-service burger) industry over the years 1991-1995, for which the market can be characterized as a duopoly. We use both reduced-form estimations and a structural model, controlling for marketspecific time-invariant unobservables. For both firms, we find that market structure matters greatly. Specificallyt rival presence increases the probability of entry by increasing expected market size, whereas variable profits per customer are increasing in the number of own outlets. Our results suggest the presence of product differentiation, firm learning, and market power.},
	number = {3},
	urldate = {2025-09-11},
	journal = {The RAND Journal of Economics},
	author = {Toivanen, Otto and Waterson, Michael},
	year = {2005},
	note = {Publisher: [RAND Corporation, Wiley]},
	pages = {680--699},
}


@article{sargent2024CritiqueConsequence,
	title = {Critique and consequence},
	volume = {141},
	issn = {03043932},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0304393223001162},
	doi = {10.1016/j.jmoneco.2023.10.001},
	abstract = {After describing the landscape in macroeconomics and econometrics in Spring 1973 when Robert E. Lucas (1976) first presented his Critique at the inaugural Carnegie-Rochester conference, I add a fourth example based on Sargent and Wallace (1973) to those in section 5 of Lucas’s paper. To portray consequences of Lucas’s Critique, I use it as a vehicle to describe the time inconsistency of optimal plans and their credibility. A theory of government policy affects chains of influence among money creation and inflation rates at different dates. Different theories of policy bring different state vectors in recursive representations of inflation-money-supply outcomes.},
